# Python cache
__pycache__/
*.pyc
*.pyo

# Database
db.sqlite3

# Media files
media/

# Collected static files (generated by `collectstatic` at deploy time)
staticfiles/

# Source static assets — served via CDN / whitenoise after `collectstatic`.
# Vendor libs (Bootstrap, FontAwesome, etc.) must NOT be committed; add them
# via npm/yarn or download to static/ locally and let collectstatic handle it.
static/assets/

# Environment files
.env

# IDE files
.idea/
.vscode/

# Dev artefacts — never commit these
*.patch
commit_message.txt

# Fixture data — load via `python manage.py loaddata` from a private location,
# not from a file checked into the repo
data.json

# SSL certificates — provisioned on the server, never committed
nginx/certs/*.pem
nginx/certs/*.key
nginx/certs/*.crt
-e 
# Backup dumps — never commit these
backups/
*.sql.gz
