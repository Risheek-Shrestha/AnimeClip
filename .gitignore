# Python cache
__pycache__/
*.pyc
*.pyo

# Database
db.sqlite3

# Media files (user uploads at runtime — never committed)
media/

# Collected static files (regenerated by `collectstatic` at deploy time —
# never committed; it's a hashed/compressed copy of static/, not a source)
staticfiles/

# static/assets/ (vendor theme: Bootstrap, FontAwesome, etc.) IS tracked.
# After repeated local-dev breakage from it being gitignored and only
# existing on individual machines, it's committed directly instead.

# Environment files
.env

# IDE files
.idea/
.vscode/

# Dev artefacts — never commit these
*.patch
commit_message.txt

# Fixture data — load via `python manage.py loaddata` from a private location,
# not from a file checked into the repo
data.json

# SSL certificates — provisioned on the server, never committed
nginx/certs/*.pem
nginx/certs/*.key
nginx/certs/*.crt

# Backup dumps — never commit these
backups/
*.sql.gz