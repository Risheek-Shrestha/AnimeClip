# Django
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False

# Allowed hosts (space-separated)
ALLOWED_HOSTS=yourdomain.com www.yourdomain.com

# Database — used by both docker-compose and Django
DB_NAME=animeclip
DB_USER=animeclip
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=db
DB_PORT=5432

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis
REDIS_URL=redis://redis:6379/1

# Email (leave EMAIL_HOST unset to fall back to console backend in dev)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Gunicorn (optional — defaults to 3 workers)
# Set to (2 x CPU cores + 1) for your deployment machine
# GUNICORN_WORKERS=3
