# Django
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False

# Allowed hosts (space-separated)
ALLOWED_HOSTS=yourdomain.com www.yourdomain.com

# Database — used by both docker-compose and Django
DB_NAME=animeclip
DB_USER=animeclip
DB_PASSWORD=replace-with-a-strong-password
DB_HOST=db
DB_PORT=5432

# Cloudinary (media storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Redis
# NOTE: REDIS_PASSWORD must be defined *above* REDIS_URL — python-dotenv
# expands ${VARS} top-to-bottom, so if REDIS_URL comes first the password
# silently resolves to empty and Redis auth fails.
# The "redis" hostname below is the docker-compose service name. Running
# without Docker? Point this at your actual Redis host instead, e.g.
# redis://:yourpassword@127.0.0.1:6379/1
REDIS_PASSWORD=replace-with-a-strong-redis-password
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379/1

# Email (leave EMAIL_HOST unset to fall back to console backend in dev)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Gunicorn (optional — defaults to 3 workers)
# Set to (2 x CPU cores + 1) for your deployment machine
# GUNICORN_WORKERS=3

# Sentry error monitoring (optional but strongly recommended in production)
# Create a free project at https://sentry.io and paste the DSN here
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Log levels (optional — default: WARNING for Django, INFO for app code)
# DJANGO_LOG_LEVEL=WARNING
# APP_LOG_LEVEL=INFO

# ── Scheduled management commands ──────────────────────────────────────────────
# The following commands must be run on a schedule in production.
# Add them to your server's crontab (crontab -e) or a scheduler like
# Heroku Scheduler / Railway Cron / APScheduler.
#
# Notify followers when a movie's release_date arrives (run daily):
#   0 8 * * * cd /app && python manage.py notify_movie_releases
#
# Regenerate ML recommendations for all users (run nightly):
#   0 2 * * * cd /app && python manage.py warm_recommendations
#
# Import/refresh anime catalog from external API (run weekly):
#   0 3 * * 0 cd /app && python manage.py import_catalog


# ── Celery (now handles scheduled tasks automatically via celery beat) ─────────
# CELERY_CONCURRENCY=2    # number of worker threads (default 2)

# ── Brute-force protection (django-axes) ───────────────────────────────────────
# Axes uses the default cache (Redis) to store failure counters.
# No additional env vars needed — REDIS_URL above is sufficient.
# To reset a locked-out IP from the shell:
#   python manage.py axes_reset_ip --ip <ip>

# ── Cloudinary CDN token authentication (optional but strongly recommended) ────
# Enables true CDN-edge URL expiry so captured video redirect links can't be
# replayed. Steps to enable:
#   1. In Cloudinary dashboard → Security → Token-based access control → Enable
#   2. Change video asset delivery type to "authenticated"
#   3. Copy the auth token signing key and paste below
# CLOUDINARY_AUTH_TOKEN_KEY=your_hex_signing_key_here
